# ==============================================================================
# TCS Automated Loan Eligibility Chatbot - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:postgres@localhost:5432/tcs_loan_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tcs_loan_db?schema=public"

# AI Provider Configuration (Default is fully offline local mock provider)
# Options: 'mock' (default) | 'gemini' (future)
AI_PROVIDER="mock"
MOCK_AI_TOKEN="mock-local-token"

# Optional: Google Gemini API Key (Only needed when AI_PROVIDER="gemini")
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Application Configuration
NEXT_PUBLIC_APP_NAME="FinSmart LoanAssist - TCS Preliminary Eligibility Engine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
